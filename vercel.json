{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "outputDirectory": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "public/**"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
